    "@tauri-apps/plugin-updater": "^2.10.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/three": "^0.186.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
